DATABASE_URL=postgresql://autohands:autohands@localhost:5432/autohands?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
# 대시보드는 같은 출처의 /api/* 로 호출하고 Next 서버가 아래 주소로 프록시합니다.
API_INTERNAL_URL=http://127.0.0.1:4000
# API 수신 주소. 비우면 API_TOKEN 이 있을 때만 0.0.0.0(외부 허용), 없으면 127.0.0.1(이 PC 에서만)
API_HOST=
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-long-random-secret
ARTIFACT_ROOT=./artifacts
# 대시보드 출처(쉼표로 여러 개). 정확히 일치해야 허용됩니다.
# 개발 모드에서는 localhost/127.0.0.1 출처가 자동 허용되고, NODE_ENV=production 에서는 여기 적은 출처만 허용됩니다.
CORS_ORIGIN=http://localhost:3000
# 한 실행 안에서 동시에 수행할 테스트 케이스 수 (대상 서비스 부하를 고려해 1~10)
QA_CONCURRENCY=3

# LLM 설정 (입력 시 규칙 + OpenAI 하이브리드 생성, 미입력 시 규칙 엔진으로 안전하게 동작)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── 보안 ──────────────────────────────────────────────────────────────────
# API 접근 토큰. 설정하면 대시보드에 로그인 화면이 생기고 모든 /api 호출에 인증이 필요합니다.
# 공유 서버에서는 반드시 설정하세요. (NODE_ENV=production 이면 없을 때 API 가 시작되지 않습니다)
# 생성 예: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_TOKEN=

# 테스트 대상 URL 정책 (SSRF 방지). 클라우드 메타데이터(169.254.x 등)는 항상 차단됩니다.
# 허용할 호스트만 지정 (쉼표, *.example.com 형식). 비우면 제한 없음.
TARGET_ALLOWLIST=
# true 면 사설 대역(10.x, 172.16-31.x, 192.168.x) 대상 차단. 사내 스테이징을 테스트한다면 false 유지.
TARGET_BLOCK_PRIVATE=false
# 운영 모드에서 localhost/127.0.0.1 대상을 허용하려면 true
TARGET_ALLOW_LOOPBACK=false
# 분석 시 최대 탐색 페이지 수
DISCOVERY_MAX_PAGES=20
# 분석 시 버튼 클릭으로 열리는 화면(SPA 폼·모달)도 탐색할지 여부. 운영 환경으로 등록된 대상은 항상 끔.
DISCOVERY_EXPLORE_CLICKS=true

# ── 외부 접속 모드 (start-public.bat) ───────────────────────────────────────
# start-public.bat 은 아래 값을 자동으로 켭니다: NODE_ENV=production, API_HOST=127.0.0.1,
# TARGET_BLOCK_PRIVATE=true(이 PC 가 속한 사내망/공유기 대역 테스트 차단), TRUST_CF_CONNECTING_IP=true
# API_TOKEN 이 비어 있으면 자동 생성되어 _public-token.txt 에 저장됩니다.
TRUST_CF_CONNECTING_IP=false

# ── 앱 테스트 (Appium) ───────────────────────────────────────────────────────
# Android/iOS 앱 환경 실행에 사용하는 Appium 서버 주소 (iOS 는 Mac 에서 실행한 Appium 주소)
APPIUM_URL=http://127.0.0.1:4723
# 화면 문구로 요소를 찾을 때 기다리는 최대 시간(ms). 느린 앱이면 늘리세요.
QA_TEXT_TIMEOUT_MS=6000
# 메뉴를 못 찾을 때 아래로 스크롤해 보는 최대 횟수 (0 = 스크롤 안 함)
QA_MAX_SCROLLS=6
# 실패 케이스 한 번 재시도 (0 = 끔). 1 이면 "메뉴를 못 찾음"도 재시도 (실행 시간 증가)
QA_RETRY=1
QA_RETRY_NAV=0
# 같은 기기를 쓰는 다른 실행이 끝나기를 기다리는 최대 시간(분)
QA_DEVICE_WAIT_MIN=30
# 앱 로그인 버튼을 누른 뒤 기다리는 시간(ms)
QA_APP_LOGIN_WAIT_MS=3000
