# 호스트(Windows) node_modules 가 Linux 이미지에 섞이면 Prisma/esbuild 네이티브 바이너리가 깨집니다.
**/node_modules
**/.next
**/dist
**/*.tsbuildinfo

# 비밀 정보는 이미지에 포함하지 않고 docker-compose 의 env_file 로 주입합니다.
.env
.env.*
!.env.example

# 산출물 / 대용량 파일
outputs
artifacts
work/smoke-artifacts
playwright-report
test-results
*.zip
*.log

# 기타
.git
.vscode
.idea
